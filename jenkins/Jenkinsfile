// jenkins/Jenkinsfile
// Pipeline declarativo para ejecutar el framework QA Automation.
// SOLO para demostracion del instructor -- el flujo principal del curso usa GitHub Actions.
//
// Para usarlo en Jenkins:
//   1. Instalar plugins: NodeJS, Pipeline, HTML Publisher, Slack Notification, Office 365 Connector
//   2. Configurar NodeJS 20 en Jenkins > Global Tool Configuration
//   3. Agregar credenciales (Manage Jenkins > Credentials): SAUCEDEMO_BASE_URL, SAUCEDEMO_USER,
//      SAUCEDEMO_PASS, SLACK_WEBHOOK, TEAMS_WEBHOOK_URL
//   4. Crear un Pipeline job apuntando a este Jenkinsfile (Script Path: jenkins/Jenkinsfile)

pipeline {
    agent any

    tools {
        // 'NodeJS-20' debe coincidir con el nombre configurado en Jenkins > Tools
        nodejs 'NodeJS-20'
    }

    environment {
        CI = 'true'
        BASE_URL = credentials('SAUCEDEMO_BASE_URL')          // secret en Jenkins
        SAUCEDEMO_USERNAME = credentials('SAUCEDEMO_USER')    // secret en Jenkins
        SAUCEDEMO_PASSWORD = credentials('SAUCEDEMO_PASS')    // secret en Jenkins
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                // descarga el codigo del repositorio
                checkout scm
            }
        }

        stage('Install') {
            steps {
                sh 'npm ci'
                sh 'npx playwright install --with-deps'
            }
        }

        stage('Playwright Tests') {
            steps {
                // mismo alcance que el job "playwright" de GitHub Actions
                sh 'npx playwright test tests/clase-05'
            }
            post {
                always {
                    // publica el reporte HTML de Playwright en Jenkins
                    publishHTML(target: [
                        reportDir  : 'playwright-report',
                        reportFiles: 'index.html',
                        reportName : 'Playwright Report'
                    ])
                    // notifica el resultado de ESTE stage -- homologado con "Notify Slack/Teams - Playwright" de GitHub Actions
                    slackSend(
                        channel: '#qa-automation',
                        color  : currentBuild.currentResult == 'SUCCESS' ? 'good' : 'danger',
                        message: "Playwright Tests: ${currentBuild.currentResult} -- `${env.JOB_NAME}` #${env.BUILD_NUMBER}\nBranch: ${env.GIT_BRANCH}\n${env.BUILD_URL}"
                    )
                    office365ConnectorSend(
                        webhookUrl: credentials('TEAMS_WEBHOOK_URL'),
                        status    : currentBuild.currentResult,
                        color     : currentBuild.currentResult == 'SUCCESS' ? '00B294' : 'C4314B',
                        message   : "Playwright Tests | Branch: ${env.GIT_BRANCH} | Build: #${env.BUILD_NUMBER}"
                    )
                }
            }
        }

        stage('Cucumber BDD Tests') {
            steps {
                sh 'npm run cucumber'
            }
            post {
                always {
                    publishHTML(target: [
                        reportDir  : '.',
                        reportFiles: 'cucumber-report.html',
                        reportName : 'Cucumber Report'
                    ])
                    // notifica el resultado de ESTE stage -- homologado con "Notify Slack/Teams - Cucumber" de GitHub Actions
                    slackSend(
                        channel: '#qa-automation',
                        color  : currentBuild.currentResult == 'SUCCESS' ? 'good' : 'danger',
                        message: "Cucumber Tests: ${currentBuild.currentResult} -- `${env.JOB_NAME}` #${env.BUILD_NUMBER}\nBranch: ${env.GIT_BRANCH}\n${env.BUILD_URL}"
                    )
                    office365ConnectorSend(
                        webhookUrl: credentials('TEAMS_WEBHOOK_URL'),
                        status    : currentBuild.currentResult,
                        color     : currentBuild.currentResult == 'SUCCESS' ? '00B294' : 'C4314B',
                        message   : "Cucumber Tests | Branch: ${env.GIT_BRANCH} | Build: #${env.BUILD_NUMBER}"
                    )
                }
            }
        }
    }

    post {
        // se ejecuta siempre, pase o falle -- solo archiva Allure, las notificaciones ya van por stage
        always {
            archiveArtifacts artifacts: 'allure-results/**', allowEmptyArchive: true
        }
    }
}
