  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "csv-parse": "^7.0.2",
    "typescript": "^7.0.2"
  }
}
